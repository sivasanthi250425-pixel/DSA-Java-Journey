

import java.util.Scanner;

class Main {

    static void prime(int n) {
    
        if(n<=1){
            System.out.println("Not prime"); 
            return;
        }
        if(n==2){
             System.out.println("prime");
            return;
        }
        if(n%2==0){
             System.out.println("Not prime");
             return;
        }
       for(int i=3;i<n;i+=2) {
           if(n%i==0){
                System.out.println("Not prime");
                return;
           }
       }
                System.out.println("prime");
           
        

    }

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
       prime(n);
      
    }
}
