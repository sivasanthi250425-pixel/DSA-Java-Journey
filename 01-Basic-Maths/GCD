import java.util.Scanner;

class Main {

    static long gcd(long n, long m) {

        while (m != 0) {
            long temp = m;
            m = n % m;
            n = temp;
        }

        return n;
    }

    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        long n = sc.nextLong();
        long m = sc.nextLong();

        System.out.println(gcd(n, m));
    }
}
