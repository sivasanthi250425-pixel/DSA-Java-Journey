import java.util.Scanner;

class Main {

    static boolean perfect(long n) {
        long s=0;
        for (int i = 1; i < n; i++) {
            if (n % i == 0) {
                s+=i;
                
            }
            
        }return s==n;
    }

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        long n = sc.nextLong();

        System.out.println(perfect(n));
    }
}
