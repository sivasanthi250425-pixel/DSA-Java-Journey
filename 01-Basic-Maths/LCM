import java.util.Scanner;

class Main {

    static long lcm(long n, long m) {

        if (n == 0 || m == 0) {
            return 0;
        }

        long a = n;
        long b = m;

        while (b != 0) {
            long temp = b;
            b = a % b;
            a = temp;
        }

        long gcd = a;

        return (n / gcd) * m;
    }

    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        long n = sc.nextLong();
        long m = sc.nextLong();

        System.out.println(lcm(n, m));
    }
}
