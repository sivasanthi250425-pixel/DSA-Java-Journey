

import java.util.Scanner;

class Main {

    static boolean prime(int n) {
    int c=0;
        if(n<=1){
            
            return false;
        }
        if(n==2){
            
            return true;
        }
        if(n%2==0){
            
          return false;
        }
       for(int i=3;i<=Math.sqrt(n);i+=2) {
           if(n%i==0){
                return false;
           }
       }
               return true;
           
        

    }

    public static void main(String[] args) {
        int c=0;
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        for(int i=0;i<=n;i++){
            if(prime(i)){
                c+=1;
            }
           
        }
         System.out.println("count "+c);
      
    }
}
