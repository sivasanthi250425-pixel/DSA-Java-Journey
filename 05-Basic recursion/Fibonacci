
import java.util.*;

class Main {

    // Recursive method
    static int fib(int n) {

        // Base conditions
        if (n == 0) {
            return 0;
        }

        if (n == 1) {
            return 1;
        }

        // Recursive calls
        return fib(n - 1) + fib(n - 2);
    }

    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        // Input
        int n = sc.nextInt();

        // Output
        System.out.println(fib(n));

        sc.close();
    }
}
