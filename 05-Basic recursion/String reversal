import java.util.*;

class Main {

    static String fact(String s) {

        if(s.equals("")){
            return "";
        }

        return s.charAt(s.length()-1) + fact(s.substring(0,s.length()-1));
    }

    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        String s = sc.nextLine();

        System.out.println(fact(s));
    }
}
