import java.util.*;

class Main {

    static int sum(int n) {

        if (n == 0) {
            return 0;
        }
 
        int d=n%10;
         n=n/10;
        
        return d+sum(n);
       
    }

    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        int n = sc.nextInt();
        

        

       System.out.println(sum(n));
    }
}
