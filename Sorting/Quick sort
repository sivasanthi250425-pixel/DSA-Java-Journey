
import java.util.*;

class Solution {

    public int[] quickSort(int[] arr) {
        int n = arr.length;
        solve(arr, 0, n - 1);
        return arr;
    }

    private void solve(int[] arr, int low, int high) {

        if (low >= high) {
            return;
        }

        int pivotIndex = partitionArray(arr, low, high);

        solve(arr, low, pivotIndex - 1);
        solve(arr, pivotIndex + 1, high);
    }

    private int partitionArray(int[] arr, int low, int high) {

        int pivot = arr[high];
        int smallerIndex = low - 1;

        for (int current = low; current < high; current++) {

            if (arr[current] <= pivot) {

                smallerIndex++;

                int temp = arr[smallerIndex];
                arr[smallerIndex] = arr[current];
                arr[current] = temp;
            }
        }

        int temp = arr[smallerIndex + 1];
        arr[smallerIndex + 1] = arr[high];
        arr[high] = temp;

        return smallerIndex + 1;
    }
}

public class Main {
    public static void main(String[] args) {

        int[] arr = {10, 7, 8, 9, 1, 5};

        Solution obj = new Solution();

        int[] answer = obj.quickSort(arr);

        for (int value : answer) {
            System.out.print(value + " ");
        }
    }
}
